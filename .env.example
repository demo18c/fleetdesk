# Copy to .env and fill in. Never commit .env.
PORT=5001
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fleetdesk?retryWrites=true&w=majority
# Browser origin for CORS. Use the Vite dev URL locally.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Generate with: openssl rand -hex 32
FLEETDESK_ACCESS_KEY=
